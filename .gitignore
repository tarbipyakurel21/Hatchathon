# ==========================================
# BioLabel — Comprehensive .gitignore
# ==========================================

# ------------------------------------------
# Environment & Secrets
# ------------------------------------------
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example

# ------------------------------------------
# Python & Virtual Environments
# ------------------------------------------
.venv/
venv/
ENV/
env/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt

# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# Unit test & coverage artifacts
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.hypothesis/

# Type checking & linter caches
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------
# Node.js & Next.js
# ------------------------------------------
node_modules/
frontend/node_modules/
.npm
.yarn/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js build output
.next/
frontend/.next/
out/
frontend/out/
.turbo/
*.tsbuildinfo

# ------------------------------------------
# Application Data & Model Weights
# ------------------------------------------
data/biolabel.db
*.db
*.sqlite
*.sqlite3

# Uploaded images, thumbnails, masks & exports (keep folder structure via .gitkeep)
data/uploads/*
!data/uploads/.gitkeep
data/thumbnails/*
!data/thumbnails/.gitkeep
data/masks/*
!data/masks/.gitkeep
data/exports/*
!data/exports/.gitkeep

# Machine learning model weights & checkpoints
*.pt
*.pth
*.bin
*.onnx
*.safetensors
data/models/*.pt
!data/models/.gitkeep

# Exported archives & temporary folders
*.zip
*.tar.gz
temp_*

# ------------------------------------------
# Operating System & File System Artifacts
# ------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------
# IDEs & Code Editors
# ------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iws
*.iml
*.ipr

# Vim / Sublime
*.swp
*.swo
*.sublime-project
*.sublime-workspace
